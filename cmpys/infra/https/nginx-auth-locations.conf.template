    # Login and registration share one budget so switching routes cannot evade it.
    location ~ ^/api/v1/auth/(login|register)/?$ {
        limit_req zone=cmpys_auth_credentials burst=10 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;
        client_max_body_size 16k;
        client_body_timeout 10s;
        error_page 429 = @cmpys_auth_limited;
        proxy_pass http://127.0.0.1:8000;
    }

    # Accommodate concurrent access-token recovery without weakening login limits.
    location ~ ^/api/v1/auth/refresh/?$ {
        limit_req zone=cmpys_auth_refresh burst=30 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;
        client_max_body_size 16k;
        client_body_timeout 10s;
        error_page 429 = @cmpys_auth_limited;
        proxy_pass http://127.0.0.1:8000;
    }

    location @cmpys_auth_limited {
        default_type application/json;
        add_header Retry-After 6 always;
        return 429 '{"detail":"Too many requests. Try again shortly."}';
    }
