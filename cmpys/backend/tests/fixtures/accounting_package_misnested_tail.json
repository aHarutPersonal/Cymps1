    "worked_solution": "\u0549\u057d\u057f\u0561\u0581\u057e\u0561\u056e \u0565\u056f\u0561\u0574\u0578\u0582\u057f\u0568 = 560000 \u2212 395000 = 165000 AMD\u0589 \u0532\u0561\u0581\u0561\u057f\u0580\u0578\u0582\u0569\u0575\u0561\u0576 \u0568\u0576\u0564\u0578\u0582\u0576\u0565\u056c\u056b \u0567\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0568\u055d \u056f\u0578\u0582\u057f\u0561\u056f\u0561\u0575\u056b\u0576 \u0570\u0561\u0577\u057e\u0561\u057c\u0574\u0561\u0574\u0562 \u0565\u056f\u0561\u0574\u0578\u0582\u057f\u0568 \u0573\u0561\u0576\u0561\u0579\u057e\u0578\u0582\u0574 \u0567, \u0565\u0580\u0562 \u0561\u057a\u0580\u0561\u0576\u0584\u0568 \u056f\u0561\u0574 \u056e\u0561\u057c\u0561\u0575\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0568 \u057e\u0561\u0573\u0561\u057c\u057e\u0578\u0582\u0574 \u0567, \u0561\u0575\u056c \u0578\u0579 \u0569\u0565 \u0565\u0580\u0562 \u0563\u0578\u0582\u0574\u0561\u0580\u0568 \u0574\u0578\u0582\u057f\u0584 \u0567 \u0563\u0578\u0580\u056e\u0578\u0582\u0574\u0589 \u0548\u0582\u057d\u057f\u056b 165000-\u0568 \u0564\u0565\u057c \u057a\u0561\u0580\u057f\u0561\u057e\u0578\u0580 \u0567 \u0570\u0561\u057e\u0561\u0584\u0565\u056c, \u056b\u057d\u056f \u0574\u056b\u0587\u0576\u0578\u0582\u0575\u0576 \u056a\u0561\u0574\u0561\u0576\u0561\u056f \u0561\u056c\u0575 \u056e\u0561\u056d\u057d\u0565\u0580\u0568 (\u0585\u0580\u056b\u0576\u0561\u056f\u055d \u0561\u056c\u0575, \u0561\u0577\u056d\u0561\u057f\u0561\u057e\u0561\u0580\u0571, \u057e\u0561\u0580\u0571\u0561\u056f\u0561\u056c\u0578\u0582\u0569\u0575\u0578\u0582\u0576) \u056f\u0561\u0580\u0578\u0572 \u0565\u0576 \u057a\u0561\u0570\u0561\u0576\u057b\u0565\u056c \u0561\u0576\u0574\u056b\u057b\u0561\u057a\u0565\u057d \u056f\u0561\u0576\u056d\u056b\u056f \u057e\u0573\u0561\u0580\u0578\u0582\u0574\u0589 \u0531\u0575\u0564 \u057a\u0561\u057f\u0573\u0561\u057c\u0578\u057e \u0570\u0561\u0577\u057e\u0565\u057f\u057e\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0568 \u056f\u0561\u0580\u0578\u0572 \u0567 \u0581\u05