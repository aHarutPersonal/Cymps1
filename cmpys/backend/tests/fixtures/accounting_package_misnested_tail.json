        "hint": "\u053f\u0578\u0582\u057f\u0561\u056f\u0561\u0575\u056b\u0576 \u0570\u0561\u0577\u057e\u0561\u057c\u0574\u0561\u0574\u0562 \u057a\u0561\u0580\u057f\u0584\u0578\u057e \u057e\u0561\u0573\u0561\u057c\u0584\u0568 \u0565\u056f\u0561\u0574\u0578\u0582\u057f \u0567 \u0561\u0576\u0563\u0561\u0574 \u0565\u0569\u0565 \u0564\u0565\u057c \u0563\u0578\u0582\u0574\u0561\u0580\u0568 \u0579\u056b \u057d\u057f\u0561\u0581\u057e\u0565\u056c, \u056b\u057d\u056f \u0579\u057e\u0573\u0561\u0580\u057e\u0561\u056e \u056e\u0561\u056d\u057d\u0568 \u056e\u0561\u056d\u057d \u0567\u0589 \u053f\u0561\u0576\u056d\u056b\u056f \u0570\u0578\u057d\u0584\u0578\u0582\u0574 \u0570\u0561\u056f\u0561\u057c\u0561\u056f\u0576 \u0567\u055d \u0570\u0561\u0577\u057e\u057e\u0578\u0582\u0574 \u0565\u0576 \u0574\u056b\u0561\u0575\u0576 \u056b\u0580\u0561\u056f\u0561\u0576 \u0583\u0578\u0572\u056b \u0577\u0561\u0580\u056a\u0578\u0582\u0574\u0576\u0565\u0580\u0568, \u0561\u0575\u0564 \u0569\u057e\u0578\u0582\u0574\u055d \u0576\u0561\u056d\u056f\u056b\u0576 \u057a\u0561\u0580\u057f\u0584\u0565\u0580\u056b\u0581 \u057d\u057f\u0561\u0581\u057e\u0561\u056e \u0563\u0578\u0582\u0574\u0561\u0580\u0568\u0589",
        "worked_solution": "\u053f\u0578\u0582\u057f\u0561\u056f\u0561\u0575\u056b\u0576 \u0565\u056f\u0561\u0574\u0578\u0582\u057f\u0568 = 900000 + 300000 = 1200000 AMD\u0589 \u053f\u0578\u0582\u057f\u0561\u056f\u0561\u0575\u056b\u0576 \u0577\u0561\u0570\u0578\u0582\u0575\u0569\u0568 = 1200000 \u2212 500000 = 700000 AMD\u0589 \u0536\u0578\u0582\u057f \u056f\u0561\u0576\u056d\u056b\u056f \u0570\u0578\u057d\u0584\u0568 = 900000 + 150000 \u2212 400000 = 650000 AMD\u0589 700000 > 650000, \u0578\u0582\u057d\u057f\u056b \u0573\u056b\u0577\u057f \u057a\u0561\u057f\u0561\u057d\u056d\u0561\u0576\u0576 \u0567\u055d \u0577\u0561\u0570\u0578\u0582\u0575\u0569\u0568 \u0574\u0565\u056e \u0567 \u056f\u0561\u0576\u056d\u056b\u056f \u0570\u0578\u057d\u0584\u056b\u0581\u0589 \u054f\u0561\u0580\u0562\u0565\u0580\u0578\u0582\u0569\u0575\u0561\u0576 \u057a\u0561\u057f\u0573\u0561\u057c\u0568\u055d \u057a\u0561\u0580\u057f\u0584\u0578\u057e \u057e\u0561\u0573\u0561\u057c\u0584\u056b \u0564\u0565\u057c \u0579\u0563\u0561\u0576\u0571\u057e\u0561\u056e 150000-\u0568 \u0570\u0561\u0576\u0561\u056e \u0579\u057e\u0573\u0561\u0580\u057e\u0561\u056e \u056e\u0561\u056d\u057d\u056b 100000-\u0568\u0589 \u0540\u0561\u0573\u0561\u056d\u0561\u056f\u056b \u057d\u056d\u0561\u056c\u055d \u056f\u0561\u0576\u056d\u056b\u056f \u0570\u0578\u057d\u0584\u056b \u0574\u0565\u057b \u057a\u0561\u0580\u057f\u0584\u0578\u057e \u057e\u0561\u0573\u0561\u057c\u0584\u0568 \u0570\u0561\u0577\u057e\u0565\u056c\u0568 \u0578\u0580\u057a\u0565\u057d \u0574\u0578\u0582\u057f\u0584, \u056f\u0561\u0574 \u056f\u0578\u0582\u057f\u0561\u056f\u0561\u0575\u056b\u0576 \u0577\u0561\u0570\u0578\u0582\u0575\u0569\u0578\u0582\u0574 \u057e\u0573\u0561\u0580\u057e\u0561\u056e \u056e\u0561\u056d\u057d\u0565\u0580\u0576 \u0585\u0563\u057f\u0561\u0563\u0578\u0580\u056e\u0565\u056c\u0568 \u056f\u0561\u057f\u0561\u0580\u057e\u0561\u056e\u056b \u0583\u0578\u056d\u0561\u0580\u0565\u0576\u0589",
