# Database
DATABASE_URL=postgresql+psycopg://cmpys:cmpys@localhost:5432/cmpys
REDIS_URL=redis://localhost:6379/0
CELERY_DEFAULT_POOL=solo
CELERY_DEFAULT_CONCURRENCY=1
CELERY_HIGH_POOL=solo
CELERY_HIGH_CONCURRENCY=1
CELERY_LOW_POOL=solo
CELERY_LOW_CONCURRENCY=1
JWT_SECRET_KEY=replace-with-a-random-production-secret
HTTP_BODY_LOGGING_ENABLED=false

# LLM
# routed: each operation runs on its assigned model (app/services/llm/routes.py),
# Claude Haiku 5.5 or gpt-6-luna, with the other as backup. dummy: fixtures.
LLM_PROVIDER=routed
# Inject keys from the deployment secret store; do not commit credentials.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: switch a stage or operation, e.g. {"books": "anthropic"}.
# LLM_ROUTE_OVERRIDES={}

# Native Google credentials: Search grounding and narration only.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_QUALITY_MODEL=gemini-3.1-pro-preview
TAVILY_API_KEY=your-tavily-api-key

# Background catalog budget / throughput
CATALOG_SCHEDULER_ENABLED=true
CATALOG_DISPATCH_PER_TICK=1
CATALOG_WORKER_POOL=solo
CATALOG_WORKER_CONCURRENCY=1
CATALOG_CONTROL_POOL=solo
CATALOG_DAILY_JOB_LIMIT=50
CATALOG_MAX_ATTEMPTS=3
CATALOG_QUOTES_PER_IDOL_LIMIT=30
CATALOG_QUOTE_MIN_CONFIDENCE=0.84
CATALOG_QUOTE_VERIFICATION_ENABLED=true
CATALOG_QUOTE_VERIFICATION_BATCH_SIZE=4
CATALOG_QUOTE_VERIFICATION_DAILY_LIMIT=2
CATALOG_IDLE_DISCOVERY_ENABLED=true
CATALOG_IDLE_DISCOVERY_INTERVAL_SECONDS=900
CATALOG_IDLE_DISCOVERY_DAILY_LIMIT=6
CATALOG_IDLE_DISCOVERY_RECENT_USER_MINUTES=10
CATALOG_IDLE_DISCOVERY_PRIORITY=10
CATALOG_IDLE_DISCOVERY_INTERACTIVE_QUEUES=high_priority,default,low_priority
LLM_USAGE_TELEMETRY_ENABLED=true
LLM_BACKGROUND_DAILY_BUDGET_USD=0.50
LLM_BACKGROUND_BUDGET_SOFT_RATIO=0.85
LLM_BUDGET_INCLUDE_SEARCH_OVERAGE=false
CATALOG_BOOK_BUDGET_RESERVE_USD=0.06
CATALOG_IDOL_BUDGET_RESERVE_USD=0.12
CATALOG_QUOTE_VERIFICATION_BUDGET_RESERVE_USD=0.04

# Evidence-based curriculum factory. Keep disabled until the pilot taxonomy is
# seeded; dedicated workers may run idle safely while this flag is false.
CURRICULUM_ENABLED=false
CURRICULUM_CONTROL_INTERVAL_SECONDS=60
CURRICULUM_MAX_DISPATCH_PER_TICK=1
CURRICULUM_MAX_RUNNING_JOBS=2
CURRICULUM_LEASE_SECONDS=1200
CURRICULUM_MAX_REPAIRS=2
CURRICULUM_DAILY_BUDGET_USD=0.20
CURRICULUM_JOB_BUDGET_USD=0.60
CURRICULUM_DAILY_JOB_LIMIT=8
CURRICULUM_DURABLE_SPACING_SCHEDULER_ENABLED=false
CURRICULUM_RESEARCH_MODEL_TIER=fast
CURRICULUM_WRITING_MODEL_TIER=balanced
CURRICULUM_REVIEW_MODEL_TIER=quality
CURRICULUM_WORKER_POOL=prefork
CURRICULUM_WORKER_CONCURRENCY=1
CURRICULUM_CONTROL_POOL=solo

# Catalog-first personalization is a safe pilot flag. A weak match or failed
# composition always continues through the existing bespoke lesson pipeline.
LESSON_CATALOG_FIRST_ENABLED=false

# One Imagen 4 illustration per published tutorial. Off by default: every image is
# a paid call. The cap counts images written to media/tutorials/ today (UTC). The
# default-queue worker must share the media volume with the web service.
TUTORIAL_ILLUSTRATIONS_ENABLED=false
TUTORIAL_ILLUSTRATION_DAILY_CAP=200
ADAPTIVE_ROUTING_ENABLED=true
ADAPTIVE_ROUTING_LOOKBACK_DAYS=30
ADAPTIVE_ROUTING_MIN_SAMPLES=20
ADAPTIVE_ROUTING_CANARY_PERCENT=10
ADAPTIVE_ROUTING_MIN_SUCCESS_RATE=0.90
ADAPTIVE_ROUTING_MIN_QUALITY_SCORE=0.90

# Expressive book narration uses direct Google Gemini.
# Uses GEMINI_API_KEY; select prebuilt voices rather than imitating real people.
BOOK_NARRATION_ENABLED=true
BOOK_NARRATION_PROVIDER=gemini
BOOK_NARRATION_GEMINI_MODEL=gemini-3.8-flash-tts
BOOK_NARRATION_GEMINI_VOICE=Sulafat
BOOK_NARRATION_GEMINI_MENTOR_VOICE=Gacrux
BOOK_NARRATION_MEDIA_DIR=media
BOOK_NARRATION_TIMEOUT_SECONDS=60
BOOK_NARRATION_SUBTITLE_TIMEOUT_SECONDS=10
BOOK_NARRATION_MAX_AUDIO_BYTES=20000000
BOOK_NARRATION_MAX_SUBTITLE_BYTES=1000000

# Plan generation
PLAN_GENERATOR_MODE=llm

# Google Books: use an encrypted AWS secret in production; never commit the key.
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_SECRET_ID=
GOOGLE_BOOKS_SECRET_REGION=us-east-1

# Optional password recovery; disabled until an existing verified sender is connected.
# Inject SMTP credentials through the deployment's protected secret mechanism.
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=587
RECOVERY_SMTP_TLS=starttls
RECOVERY_SMTP_USERNAME=
RECOVERY_SMTP_PASSWORD=
RECOVERY_EMAIL_SENDER=
